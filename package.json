{
  "name": "mj-dw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,docs -c blue,magenta \"npm:dev:app\" \"npm:dev:docs\"",
    "dev:app": "vite",
    "dev:docs": "npm run start --prefix docs-site",
    "build": "tsc -b && vite build",
    "build:docs": "npm run build --prefix docs-site",
    "build:all": "npm run build && npm run build:docs && mkdir -p dist/docs && cp -r docs-site/build/. dist/docs",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:screenshots": "node _local-dev/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
